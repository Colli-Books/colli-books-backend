POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

POSTGRES_DB=colli_books
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/colli_books

BACKEND_PORT=8000

# Autenticação (em produção, JWT_SECRET é obrigatório e precisa de 32+ caracteres)
APP_ENV=development
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo


ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
INVITE_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=30
MEDIA_DIR=media
COVER_MAX_BYTES=5242880

# E-mail transacional (Brevo). Chave vazia: os e-mails vão para o log (desenvolvimento)
BREVO_API_KEY=
# IDs dos templates transacionais criados no painel do Brevo (0 = não configurado).
# Convite novo e renovado podem usar o mesmo template: basta repetir o ID.
BREVO_TEMPLATE_INVITE=0
BREVO_TEMPLATE_INVITE_RENEWAL=0
BREVO_TEMPLATE_PASSWORD_RESET=0

# Base dos links de convite/redefinição abertos pelo app mobile
APP_LINK_BASE_URL=collibooks://
# Capas das obras: pasta servida em /media e tamanho máximo do upload
